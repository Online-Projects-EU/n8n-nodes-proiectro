{
  "name": "n8n-nodes-proiectro",
  "version": "0.3.0",
  "description": "n8n nodes to automate your business workflows with Proiect.ro",
  "keywords": ["n8n-community-node-package"],
  "license": "MIT",
  "author": {
    "name": "Proiect.ro",
    "email": "contact@proiect.ro",
    "url": "https://proiect.ro"
  },
  "homepage": "https://proiect.ro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Online-Projects-EU/n8n-nodes-proiectro.git"
  },
  "bugs": {
    "url": "https://github.com/Online-Projects-EU/n8n-nodes-proiectro/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "nodes": [
      "dist/nodes/Proiectro/Proiectro.node.js",
      "dist/nodes/Proiectro/ProiectroTrigger.node.js"
    ],
    "credentials": [
      "dist/credentials/ProiectroApi.credentials.js"
    ]
  },
  "files": ["dist"],
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.43.4",
    "typescript": "5.9.3",
    "eslint": "9.32.0",
    "prettier": "3.6.2"
  }
}
